# Check for variable correlation

chelsa.dat = read.csv('Results/chelsa_background.csv')[2:20]
chelsa.dat <- chelsa.dat[, sapply(chelsa.dat, is.numeric)]

uncorrelated_vars <- vifstep(chelsa.dat, th=10)
uncorr = uncorrelated_vars@results$Variables
uncorr.numbers = gsub('CHELSA_bio10_', '', uncorr)


table(is.na(chelsa.dat))
chelsa.dat.na = na.omit(chelsa.dat)

chelsa.sel = chelsa.dat.na[, uncorr]

pca_result <- ade4::dudi.pca(chelsa.sel, center = TRUE, scale = TRUE, scannf = FALSE, nf = 5)

# Screen plot
barplot(pca_result$eig, main = "Eigenvalues", col = "skyblue")

# Correlation circle
s.corcircle(pca_result$co)


#To get the contributions of variables to the principal components:
contrib <- inertia.dudi(pca_result, row.inertia = FALSE, col.inertia = TRUE)
print(contrib$col.abs)

#To extract the scores of your sites on the principal components:
  site_scores <- as.data.frame(pca_result$li)

#If you want to know how much variance is explained by each principal component:
variance_explained <- pca_result$eig / sum(pca_result$eig) * 100
print(variance_explained)


# Add cos2 values to the dataframe
var_coord$cos2 <- rowSums(pca_result$var$cos2[, 1:2])

# Extract variable coordinates
var_coord <- as.data.frame(pca_result$co)

# Calculate percentage of variance explained
eig_percent <- (pca_result$eig / sum(pca_result$eig)) * 100
# Calculate contributions
contrib <- inertia.dudi(pca_result, row.inertia = FALSE, col.inertia = TRUE)
var_contrib <- rowSums(contrib$col.abs[, 1:2])

# Add contributions to the dataframe
var_coord$contrib <- var_contrib

# Modified plot with color
ggplot(var_coord, aes(x = Comp1, y = Comp2, color = contrib)) +
  geom_point() +
  geom_text_repel(aes(label = rownames(var_coord)), size = 3) +
  geom_segment(aes(x = 0, y = 0, xend = Comp1, yend = Comp2), arrow = arrow(length = unit(0.2, "cm"))) +
  geom_vline(xintercept = 0, linetype = "dashed", color = "gray") +
  geom_hline(yintercept = 0, linetype = "dashed", color = "gray") +
  xlim(-1, 1) + ylim(-1, 1) +
  coord_fixed() +
  scale_color_gradient(low = "lightblue", high = "darkblue") +
  theme_minimal() +
  labs(
    title = "Dudi PCA Correlation Circle",
    x = paste0("PC1 (", round(eig_percent[1], 2), "%)"),
    y = paste0("PC2 (", round(eig_percent[2], 2), "%)"),
    color = "Contribution"
  ) +
  theme(plot.title = element_text(hjust = 0.5))
