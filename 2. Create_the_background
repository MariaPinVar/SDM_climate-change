2. Climate raster (grid) data
## CHELSA Bioclim layers GeoTIFF files (CHELSA V2.1, 1981-2010; horizontal resolution of 30 arc sec; Karger et al. 2017 Sci Data DOI 10.1038/sdata.2017.122 & Karger et al. 2017 Dryad DOI 10.5061/dryad.kd1d4; obtained from https://chelsa-climate.org/bioclim/)
## create a RasterStack for the bc layers

bc.stack <- stack(list.files(path_to_chelsa, pattern = "^CHELSA_bio.*\\.tif", full.names = TRUE))

## make factor object for bc layers
names.bc <- names(bc.stack)
names.bc

for(region in c("EA", "SA")){
  print(region)
  if(region == "EA"){
    gens = c("Helichrysum", "Lobelia", "Dendrosenecio")
    
  }else{
    gens = c("Senecio",   "Oritrophium","Loricaria",   "Espeletia")
  }

  dat.spp.all = setNames(data.frame(matrix(ncol = 3, nrow = 0)), c("Species", "Longitude", "Latitude"))
  for(gen in gens){
    dat.spp.in <- readRDS(paste0("./DATA/", gen, "_cleaned_occurrences.INGROUP.RDS", sep=""));
    
    names(dat.spp.in)
    dat.spp.in= dat.spp.in[1:3]
    dat.spp.all = rbind(dat.spp.all, dat.spp.in)
   
  }

  head(dat.spp.all)
  names(dat.spp.all)
  # Remove rows where the 'value' column is greater than 0
  dat.spp.all <- dat.spp.all[dat.spp.all$longitude <= 0, ]
  
  world.sf <- ne_countries(scale = "medium", returnclass = "sf")
  
  plot(st_geometry(world.sf))
  points(dat.spp.all[2:3])

  ###############################################
  ## 2.1 New World + Old World background (NW / OW bg): sample some spatial points (sp) within the study area (for the background/ranges/areas)
  
  ## 2.1.1 define the global study area per range (NW and OW) by concave polygons (convex hulls that may contain concave edges) around species occurrences
  
  ## Convert dat.spp (data frame) to sf, concaveman only reads matrix of coordinates, sf and SpatialPoint objects
  tmp.dat.spp.sf <- st_as_sf(dat.spp.all, coords = c("longitude" , "latitude"))
  plot(tmp.dat.spp.sf)
  ## create the concave polygon around species occurrences and set the CRS
  tmp.dat.spp.cnc1 <- concaveman::concaveman(tmp.dat.spp.sf, concavity = 2, length_threshold = 5)
  tmp.dat.spp.cnc1 <- st_set_crs(tmp.dat.spp.cnc1, st_crs(world.sf))
  
  plot(tmp.dat.spp.cnc1)
  sf_use_s2(FALSE)
  bgs.ow.sp = st_make_valid(tmp.dat.spp.cnc1)
  st_is_valid(bgs.ow.sp)
  
  bgs.ow.sp <- st_buffer(bgs.ow.sp, dist = 1) # add the buffer
  bgs.ow.sp <- st_set_crs(bgs.ow.sp, st_crs(world.sf)) # set the CRS
  bgs.ow.sp <- st_intersection(world.sf, bgs.ow.sp) # adjust polygons to the coast line
  bgs.ow.sp <- st_union(bgs.ow.sp) # combine the polygons that span >1 country to one polygon per bg
  bgs.ow.sp <- as_Spatial(bgs.ow.sp) # convert to sp polygon
  plot(bgs.ow.sp)
  sf_use_s2(TRUE)
  saveRDS(bgs.ow.sp, file = paste0("./DATA/", region, "background_all_polygon.RDS", sep=""))
  
  plot(st_geometry(world.sf))
  plot(bgs.ow.sp, col="red", pch=16, add=TRUE)
}


bgs.EA = readRDS(paste0("./DATA/", "EA", "background_all_polygon.RDS", sep=""))
bgs.SA = readRDS(paste0("./DATA/", "SA", "background_all_polygon.RDS", sep=""))

bgs = bgs.EA+bgs.SA
plot(bgs)
#bgs <- st_as_stars(bgs, as_points = FALSE, merge = TRUE )
bgs <- st_as_sf(bgs, as_points = FALSE, merge = TRUE )
bgs <- st_make_valid(bgs)

pts.pp=st_sample(bgs, 15000)
sf_points <- st_sf(geometry = pts.pp, number = 1:length(pts.pp))
points.df <- data.frame(
  number = sf_points$number,
  latitude = st_coordinates(sf_points)[, 2],
  longitude = st_coordinates(sf_points)[, 1]
)
coordinates(points.df)= ~ longitude+ latitude

# Check variable correlation
chelsa.dat=raster::extract(bc.stack,points.df)
chelsa.dat = as.data.frame(chelsa.dat)
write.csv(chelsa.dat, 'Results/chelsa_background.csv')
usdm::vif(chelsa.dat)
cor.full = cor(chelsa.dat,  use="complete.obs", method = 'pearson')
write.csv(cor.full, "Results/chelsa_all_correlation.csv")
vif_results <- vif(chelsa.dat)

print(vif_results)

# Select uncorrelated variables using a VIF threshold (commonly 10):

uncorrelated_vars <- vifstep(chelsa.dat, th=10)
print(uncorrelated_vars)

