get_stats <- function(df, groupvar, statvar) {
  q_statvar <- as.name(statvar)
  q_groupvar <- as.name(groupvar)
  
  
  df %>% 
   group_by(!!q_groupvar) %>% 
    select(all_of(statvar))  %>%
    summarise(
      median = median(!!q_statvar, na.rm = TRUE),
      mean = mean(!!q_statvar, na.rm = TRUE),
      sd = sd(!!q_statvar, na.rm = TRUE),
      q95 = quantile(!!q_statvar, 0.95, na.rm = TRUE),
      q5 = quantile(!!q_statvar, 0.05, na.rm = TRUE),
      min = min(!!q_statvar, na.rm = TRUE),
      max = max(!!q_statvar, na.rm = TRUE),
      range.min.max = max-min,
      range.q = q95-q5,
      #  wilcox.test = wilcox.test(q_statvar~q_groupvar, data=df), 
      n = n())  %>%
    return( )
} 


get_stats_species <- function(df) {
  mean <- mean(df, na.rm=TRUE)
  min = min(df, na.rm=TRUE)
  max = max(df, na.rm=TRUE)  
  median = median(df, na.rm=TRUE)
  q5=quantile(df, 0.05, na.rm=TRUE)
  q95=quantile(df, 0.95, na.rm=TRUE)
  range.mm = max-min
  range.q = q95-q5
  new.line<-data.frame(mean, min, max, median, q5, q95, range.mm, range.q)
  colnames(new.line)<-c("mean","min", 'max', "median", "q5", 'q95', "range.mm", "range.q") 
  return(new.line )
} 
