get_path = function(model){
  # get the directory name for your model
  if(model == "fuMPI"){
    dir = "maxent_outputsfutureMPI"
  }else if(model == "fuMIROC"){
    dir = "maxent_outputsfutureMIROC"
  }else if(model == "cu"){
    dir = "maxent_outputs"
  }else  if(model == "miroc"){
    dir = "maxent_outputs_past"
  }else  if(model == "mpi"){
    dir = "maxent_outputs_pastMPI"
  }else if(model == "fuMIROC26"){
    dir = "maxent_outputsfutureMIROC26"
  }else{
    print("model name is wrong")
    stop("model name is wrong")
  }
  return(dir)
}

